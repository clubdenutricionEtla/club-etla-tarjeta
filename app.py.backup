# ===== QR CON TIPO DE USUARIO =====

def generate_qr_with_role(client):
    """Genera QR con el rol del usuario"""
    try:
        # El QR contiene: {rol}:{id}
        qr_data = f"{client.role}:{client.id}"
        
        qr = qrcode.QRCode(version=1, box_size=10, border=4)
        qr.add_data(qr_data)
        qr.make(fit=True)
        
        img = qr.make_image(fill_color="black", back_color="white")
        buffered = BytesIO()
        img.save(buffered, format="PNG")
        img_str = base64.b64encode(buffered.getvalue()).decode()
        
        return f"data:image/png;base64,{img_str}"
    except Exception as e:
        print(f"Error generando QR: {e}")
        return None

@app.route('/api/qr/<int:client_id>')
def get_qr_data(client_id):
    """Devuelve el QR de un usuario con su rol"""
    client = Client.query.get(client_id)
    if not client:
        return jsonify({'error': 'Usuario no encontrado'}), 404
    
    qr_data = f"{client.role}:{client.id}"
    return jsonify({
        'qr_data': qr_data,
        'role': client.role,
        'name': client.name,
        'id': client.id
    })

@app.route('/api/scan-qr-role', methods=['POST'])
def scan_qr_role():
    """Escanea QR y devuelve el tipo de usuario"""
    data = request.json
    qr_text = data.get('qr_data', '')
    
    # Parsear QR: role:id
    parts = qr_text.split(':')
    if len(parts) != 2:
        return jsonify({'error': 'QR no válido'}), 400
    
    role, user_id = parts[0], parts[1]
    
    # Buscar usuario
    if role == 'client':
        user = Client.query.get(user_id)
        if not user:
            return jsonify({'error': 'Cliente no encontrado'}), 404
        return jsonify({
            'type': 'client',
            'name': user.name,
            'id': user.id,
            'redirect': url_for('card'),
            'message': f'👤 Cliente: {user.name}'
        })
    elif role == 'employee':
        user = Employee.query.get(user_id)
        if not user:
            return jsonify({'error': 'Empleado no encontrado'}), 404
        return jsonify({
            'type': 'employee',
            'name': user.name,
            'id': user.id,
            'redirect': url_for('employee_dashboard'),
            'message': f'👨‍💼 Empleado: {user.name}'
        })
    elif role == 'admin':
        user = Employee.query.filter_by(id=user_id, role='admin').first()
        if not user:
            return jsonify({'error': 'Administrador no encontrado'}), 404
        return jsonify({
            'type': 'admin',
            'name': user.name,
            'id': user.id,
            'redirect': url_for('admin_dashboard'),
            'message': f'⚙️ Administrador: {user.name}'
        })
    else:
        return jsonify({'error': 'Rol no válido'}), 400

