@app.route('/admin/qr')
def admin_qr():
    """Página de gestión de QR"""
    import qrcode
    from io import BytesIO
    import base64
    
    def generate_test_qr(data):
        qr = qrcode.QRCode(version=1, box_size=8, border=2)
        qr.add_data(data)
        qr.make(fit=True)
        img = qr.make_image(fill_color="black", back_color="white")
        buffered = BytesIO()
        img.save(buffered, format="PNG")
        img_str = base64.b64encode(buffered.getvalue()).decode()
        return f"data:image/png;base64,{img_str}"
    
    # Generar QR para cada tipo
    client_qr = generate_test_qr("client:1")
    employee_qr = generate_test_qr("employee:1")
    admin_qr = generate_test_qr("admin:1")
    
    return render_template('admin/qr_management.html',
                         client_qr=client_qr,
                         employee_qr=employee_qr,
                         admin_qr=admin_qr)

# ===== QR DE REGISTRO =====

@app.route('/qr-registro')
def qr_registro():
    """QR para que los clientes se registren"""
    import qrcode
    from io import BytesIO
    import base64
    
    # El QR apunta a la página de registro
    registro_url = url_for('register', _external=True)
    
    qr = qrcode.QRCode(version=1, box_size=10, border=4)
    qr.add_data(registro_url)
    qr.make(fit=True)
    img = qr.make_image(fill_color="black", back_color="white")
    buffered = BytesIO()
    img.save(buffered, format="PNG")
    img_str = base64.b64encode(buffered.getvalue()).decode()
    qr_data = f"data:image/png;base64,{img_str}"
    
    return render_template('qr_registro.html', qr_registro=qr_data)

@app.route('/qr-empleado')
def qr_empleado():
    """QR para empleados (escáner de visitas)"""
    import qrcode
    from io import BytesIO
    import base64
    
    # El QR apunta al panel de empleado
    empleado_url = url_for('employee_dashboard', _external=True)
    
    qr = qrcode.QRCode(version=1, box_size=10, border=4)
    qr.add_data(empleado_url)
    qr.make(fit=True)
    img = qr.make_image(fill_color="black", back_color="white")
    buffered = BytesIO()
    img.save(buffered, format="PNG")
    img_str = base64.b64encode(buffered.getvalue()).decode()
    qr_data = f"data:image/png;base64,{img_str}"
    
    # Obtener empleado actual si existe
    empleado_nombre = None
    empleado_email = None
    empleado_rol = None
    empleado_id = None
    
    if 'employee_id' in session:
        empleado = Employee.query.get(session['employee_id'])
        if empleado:
            empleado_nombre = empleado.name
            empleado_email = empleado.email
            empleado_rol = empleado.role
            empleado_id = empleado.id
    
    return render_template('qr_empleado.html', 
                         qr_empleado=qr_data,
                         empleado_nombre=empleado_nombre,
                         empleado_email=empleado_email,
                         empleado_rol=empleado_rol,
                         empleado_id=empleado_id)

